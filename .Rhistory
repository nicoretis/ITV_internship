extinct_year <- function(table){
years<- table |>
group_by(simulation) |>
summarise(extinct = n() < 101) |> pull() #when we have less than 101 rows it means they get extinct before time.
# summarise(total_extinct = extinct) |> pull()
return(years)}
extinct_year(high)
extinct_year <- function(table){
table %>%
group_by(simulation) %>%
summarise(extinct_year = if(n() < 101) max(year) else NA_real_) %>%
pull(extinct_year)
}
extinct_year(high)
